{
  "name": "@pirate/shared",
  "version": "1.0.0",
  "description": "Public packages.",
  "private": true,
  "type": "commonjs",
  "author": "lxl",
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.mjs",
      "require": "./dist/enums/index.js"
    },
    "./const": {
      "types": "./dist/const/index.d.ts",
      "import": "./dist/const/index.mjs",
      "require": "./dist/const/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "tsup": "^8.3.5"
  }
}